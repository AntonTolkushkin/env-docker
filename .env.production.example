# Production defaults for Ubuntu + an existing Traefik instance.
APP_ENV=production
COMPOSE_PROJECT_NAME=bitrix-prod
TZ=Europe/Moscow

# Nginx is exposed to Traefik through its Docker network. The loopback port is
# intentionally kept for local health checks and pre-DNS testing on the server.
NGINX_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8588
WWW_PATH=/srv/bitrix/www
BACKUP_PATH=/srv/bitrix/backups

# Generated automatically by scripts/init-env.sh.
MYSQL_DATABASE=bitrix
MYSQL_USER=bitrix
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Tune these after measuring the production host. 2G assumes at least 6-8 GB RAM.
MYSQL_INNODB_BUFFER_POOL_SIZE=2G
MYSQL_MAX_CONNECTIONS=200
MYSQL_MAX_ALLOWED_PACKET=256M

LOG_MAX_SIZE=20m
LOG_MAX_FILE=10

PHP_IMAGE=quay.io/bitrix24/php:8.4.25-fpm-v1-alpine
NGINX_IMAGE=quay.io/bitrix24/nginx:1.30.4-v1-alpine
MYSQL_IMAGE=quay.io/bitrix24/percona-server:8.0.46-v1-rhel
REDIS_IMAGE=redis:8.2.9-alpine

# Replace these values before the first production deployment.
TRAEFIK_HOST_RULE='Host(`example.com`) || Host(`www.example.com`)'
TRAEFIK_NETWORK=proxy
TRAEFIK_ROUTER_NAME=bitrix
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_HTTPS_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
