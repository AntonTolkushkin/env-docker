# Local Docker Desktop / Docker Engine defaults.
APP_ENV=local
COMPOSE_PROJECT_NAME=bitrix-local
TZ=Europe/Moscow

# The site is reachable only from this computer.
NGINX_BIND_ADDRESS=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
WWW_PATH=./www
BACKUP_PATH=./backups

# Generated automatically by scripts/init-env.sh or scripts/init-env.ps1.
MYSQL_DATABASE=bitrix
MYSQL_USER=bitrix
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Conservative defaults for a developer workstation.
MYSQL_INNODB_BUFFER_POOL_SIZE=512M
MYSQL_MAX_CONNECTIONS=100
MYSQL_MAX_ALLOWED_PACKET=256M

# Container log rotation.
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5

# Image pins inherited from bitrix-tools/env-docker.
PHP_IMAGE=quay.io/bitrix24/php:8.4.25-fpm-v1-alpine
NGINX_IMAGE=quay.io/bitrix24/nginx:1.30.4-v1-alpine
MYSQL_IMAGE=quay.io/bitrix24/percona-server:8.0.46-v1-rhel
REDIS_IMAGE=redis:8.2.9-alpine
